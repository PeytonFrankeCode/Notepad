{
  "name": "notepad",
  "version": "2.0.0",
  "description": "A Reflect-style notetaking app on Cloudflare Pages + Functions + D1: daily log, backlinks, rich text, accounts, and isolated notebooks.",
  "private": true,
  "type": "module",
  "scripts": {
    "db:local": "wrangler d1 execute notepad-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute notepad-db --remote --file=./schema.sql",
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
