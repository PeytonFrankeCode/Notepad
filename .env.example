# Copy to `.env` and fill in. Used by docker-compose and (optionally) the server.

# REQUIRED: signs session tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives (bare-node runs; Docker sets its own).
DB_PATH=./data/nodebook.sqlite

# Network binding for a bare `node server/index.js` run.
HOST=0.0.0.0
PORT=3000

# Set true ONLY if this process itself serves HTTPS. If TLS is terminated by a
# reverse proxy (recommended), leave false and set TRUST_PROXY instead.
COOKIE_SECURE=false

# Express "trust proxy" value when running behind nginx/Caddy/Traefik so the
# app can see the real protocol/IP (e.g. loopback, uniquelocal, or an IP list).
TRUST_PROXY=loopback
